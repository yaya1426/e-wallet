# Local-development values. Copy to .env (git-ignored) or export in your shell.
# No real secrets belong here.

# wallet (cmd/wallet)
DATABASE_URL=postgres://wallet:wallet@localhost:5432/wallet?sslmode=disable
HTTP_ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=25s
# Access tokens (TDR-011). DEV ONLY value; at least 32 bytes. Production sets its own secret.
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
JWT_TTL=15m
# Unit of work (TDR-010 §5): per-transaction timeouts and retries on deadlock /
# serialization failure / lock timeout before answering 503 TRY_AGAIN.
DB_LOCK_TIMEOUT=2s
DB_STATEMENT_TIMEOUT=5s
DB_TX_MAX_RETRIES=3
# Bank gateway (TDR-008): the bank simulator; required by serve.
BANK_BASE_URL=http://localhost:9090
BANK_HTTP_TIMEOUT=5s

# Webhook HMAC secret shared by the wallet and banksim (TDR-007). DEV ONLY; at least 32 bytes.
BANK_WEBHOOK_SECRET=dev-only-bank-webhook-secret-0123456789

# banksim (cmd/banksim)
BANKSIM_HTTP_ADDR=:9090
BANKSIM_WEBHOOK_URL=http://localhost:8080/webhooks/bank
BANKSIM_WEBHOOK_DELAY=2s

# docker compose: host port for PostgreSQL (change it if 5432 is already taken)
POSTGRES_HOST_PORT=5432
