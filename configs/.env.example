# Local-development values. Copy to .env (git-ignored) or export in your shell.
# No real secrets belong here.

# wallet (cmd/wallet)
DATABASE_URL=postgres://wallet:wallet@localhost:5432/wallet?sslmode=disable
HTTP_ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=25s
# Access tokens (TDR-011). DEV ONLY value; at least 32 bytes. Production sets its own secret.
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
JWT_TTL=15m
# Unit of work (TDR-010 §5): per-transaction timeouts and retries on deadlock /
# serialization failure / lock timeout before answering 503 TRY_AGAIN.
DB_LOCK_TIMEOUT=2s
DB_STATEMENT_TIMEOUT=5s
DB_TX_MAX_RETRIES=3
# API idempotency keys (TDR-005 layer 1): how long a key is kept, and how often expired keys
# are deleted.
IDEMPOTENCY_TTL=24h
IDEMPOTENCY_CLEANUP_INTERVAL=1h
# Outbox delivery (TDR-006); with OUTBOX_ENABLED=false events are enqueued, not delivered.
# QUEUE_POLL_INTERVAL is shared by the outbox and the webhook inbox.
OUTBOX_ENABLED=true
OUTBOX_WORKERS=8
OUTBOX_MAX_ATTEMPTS=10
QUEUE_POLL_INTERVAL=500ms
# Money limits in piasters (PRD-001 §5.6; 1 EGP = 100).
LIMIT_TOPUP_MIN=1000
LIMIT_TOPUP_MAX=3000000
LIMIT_WITHDRAWAL_MIN=1000
LIMIT_WITHDRAWAL_MAX=3000000
LIMIT_P2P_MIN=100
LIMIT_P2P_MAX=3000000
LIMIT_MAX_BALANCE=10000000
LIMIT_DAILY_OUTGOING=6000000
# Bank gateway (TDR-008): the bank simulator; required by serve.
BANK_BASE_URL=http://localhost:9090
BANK_HTTP_TIMEOUT=5s

# Webhook HMAC secret shared by the wallet and banksim (TDR-007). DEV ONLY; at least 32 bytes.
BANK_WEBHOOK_SECRET=dev-only-bank-webhook-secret-0123456789
# Webhook inbox workers (TDR-007); with INBOX_ENABLED=false events are stored, not processed.
INBOX_ENABLED=true
INBOX_WORKERS=4
INBOX_MAX_ATTEMPTS=10
# Reconciliation jobs (TDR-009); with RECON_ENABLED=false this instance runs none.
RECON_ENABLED=true
# pending_bank_ops: ask the bank about transactions PROCESSING longer than MIN_AGE (lost webhooks).
RECON_PENDING_INTERVAL=1m
RECON_PENDING_MIN_AGE=10m
RECON_PENDING_RECHECK=5m
RECON_PENDING_BATCH=100
# dead_outbox: resolve requests whose bank call went DEAD; stuck_alert: flag transactions
# not final after RECON_STUCK_AGE.
RECON_DEAD_INTERVAL=5m
RECON_DEAD_BATCH=100
RECON_STUCK_INTERVAL=15m
RECON_STUCK_AGE=24h

# banksim (cmd/banksim)
BANKSIM_HTTP_ADDR=:9090
BANKSIM_WEBHOOK_URL=http://localhost:8080/webhooks/bank
BANKSIM_WEBHOOK_DELAY=2s

# docker compose: host port for PostgreSQL (change it if 5432 is already taken)
POSTGRES_HOST_PORT=5432

# End-to-end tests (make e2e, test/e2e) against the running compose stack
WALLET_URL=http://localhost:8080
BANKSIM_URL=http://localhost:9090
# The compose database from the host (match POSTGRES_HOST_PORT); used for the ledger checks.
E2E_DATABASE_URL=postgres://wallet:wallet@localhost:5432/wallet?sslmode=disable
# DEV ONLY: must equal the compose BANK_WEBHOOK_SECRET.
E2E_BANK_WEBHOOK_SECRET=dev-only-bank-webhook-secret-0123456789
